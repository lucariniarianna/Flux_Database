resample_stack <- function(stack, new_resolution = 20) {
 template_raster <- rast(ext(stack), res = new_resolution, crs = crs(stack))
 resampled_stack <- resample(stack, template_raster, method = "bilinear")
  
  return(resampled_stack)
}

resampled_stack <- resample_stack(stack, new_resolution = 20)

