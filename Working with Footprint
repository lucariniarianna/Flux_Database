  # Rasterize the matrix adding the x and y coordinates, the CRS, and the resolution
  r0 <- rast(FPOut$fclim_2d)
  utm_crs <- "EPSG:32630"
  
  x_center <- 263038.39364641
  y_center <- 4424957.6303515
  xmin <- x_center - 50
  xmax <- x_center + 50
  ymin <- y_center - 50
  ymax <- y_center + 50
  
  # Define the footprint as a polygon
  footprint <- vect(matrix(c(
    xmin, ymin,
    xmax, ymin,
    xmax, ymax,
    xmin, ymax,
    xmin, ymin  # Close the polygon
  ), ncol=2, byrow=TRUE), type="polygons", crs=utm_crs)  # Adjust CRS if needed
  
  # Set resolution for the raster
  res_x <- 1
  res_y <- 1
  
  # Create an empty raster with the desired extent and resolution
  r_footprint <- rast(FPOut$fclim_2d, type="",ext(xmin, xmax, ymin, ymax),  crs = utm_crs)
  
  # Check if footprint is valid
  if (nrow(FPOut$fclim_2d) == 0) {
    message("Invalid footprint geometry, skipping this iteration")
    next
  }


output_file <- file.path(OPath, paste0("footprint_", basename(file_list[[i]]), ".tif"))
  writeRaster(r_footprint, output_file, overwrite=TRUE)
  gc()
  
}

