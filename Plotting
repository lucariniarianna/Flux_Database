#### Funzione: converti coordinate torre in UTM ####
TowCoords_2_UTM <- function(TowCoord) {
  xy <- data.frame(ID = 1, X = TowCoord[2], Y = TowCoord[1])
  coordinates(xy) <- c("X", "Y")
  proj4string(xy) <- CRS("+proj=longlat +datum=WGS84 +no_defs")
  TC_UTM <- spTransform(xy, CRS("+proj=utm +zone=30"))
  return(TC_UTM)
}

#### Funzione: genera la mappa del footprint ####
FP2MapConv <- function(TCUTM, FP, IsoLineNo, MapExt) {
  Isodf10 <- data.frame(
    'x' = FP$xr[[IsoLineNo]] + TCUTM@coords[1],
    'y' = FP$yr[[IsoLineNo]] + TCUTM@coords[2]
  )
  NAIDX <- which(is.na(Isodf10$x))
  if (length(NAIDX) >= 1) Isodf10 <- Isodf10[-NAIDX,]
  if (nrow(Isodf10) == 0) stop("❌ Nessun punto valido in FP$xr / FP$yr")
  
  Iso10Points <- SpatialPoints(coords = Isodf10, proj4string = CRS("+proj=utm +zone=30 +datum=WGS84"))
  Iso10EPSG <- spTransform(Iso10Points, CRSobj = CRS("+proj=longlat +datum=WGS84 +no_defs"))
  Iso10EPSG@bbox <- matrix(c(MapExt[2], MapExt[1], MapExt[4], MapExt[3]), nrow = 2, ncol = 2)
  return(Iso10EPSG)
}

